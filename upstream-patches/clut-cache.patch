Upstream patch: CLUT-cache ([G3-CLUT], ported by G5).
Per-Submit memo of resolved palette entries; invalidated on
Submit/TextureFlush/Reset. Self-contained; apply with `patch -p1`
from the repo root against the pinned upstream revision.
--- a/upstream/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
+++ b/upstream/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
@@ -3,6 +3,7 @@
 #include "runtime/gs/gs_backend.h"
 
 #include <array>
+#include <cstdint>
 #include <functional>
 #include <mutex>
 #include <vector>
@@ -72,4 +73,10 @@
     GSTransferSnapshot m_transferState{};
     std::vector<uint8_t> m_localToHostBuffer;
     size_t m_localToHostReadPos = 0;
+
+    // [G3-CLUT] Per-Submit memo keyed by raw texel index.
+    void invalidateClutCache();
+    std::array<uint32_t, 256> m_clutCache{};
+    std::array<uint32_t, 256> m_clutTag{};
+    uint32_t m_clutGen = 0; // 0 = invalid; bumped per Submit/TextureFlush/Reset
 };
--- a/upstream/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
+++ b/upstream/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
@@ -551,10 +551,21 @@
 {
     std::lock_guard<std::mutex> lock(m_mutex);
     ResetUnlocked();
+}
+
+void GSCpuBackend::invalidateClutCache()
+{
+    // [G3-CLUT] Generation bump; tags clear on 32-bit wrap.
+    if (++m_clutGen == 0)
+    {
+        m_clutTag.fill(0);
+        m_clutGen = 1;
+    }
 }
 
 void GSCpuBackend::ResetUnlocked()
 {
+    invalidateClutCache(); // [G3-CLUT]
     m_transfer = {};
     m_transfer.direction = 3u;
     m_transferState = {};
@@ -568,6 +579,7 @@
     std::lock_guard<std::mutex> lock(m_mutex);
     if (!m_vram || batch.vertexCount == 0u)
         return;
+    invalidateClutCache(); // [G3-CLUT] per-Submit memo scope
     DrawPrimitive(batch);
 }
 
@@ -580,6 +592,8 @@
 {
     // CPU texture reads are coherent with local memory. Future cached/GPU
     // backends use this boundary to invalidate texture views.
+    std::lock_guard<std::mutex> lock(m_mutex);
+    invalidateClutCache(); // [G3-CLUT] documented invalidation boundary
 }
 
